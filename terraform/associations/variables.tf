variable "vm_associations" {
  description = "VM backup associations generated by Python"

  type = map(object({
    location    = string
    resource    = string
    backup_plan = string
  }))

  default = {}

  validation {
    condition = alltrue([
      for association in values(var.vm_associations) :
      contains(
        ["northamerica-northeast1", "northamerica-northeast2"],
        association.location
      )
    ])

    error_message = "Unsupported backup association region."
  }
}